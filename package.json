{
  "name": "todox",
  "version": "3.10.0",
  "description": "一个现代化的桌面任务清单应用 - 支持项目管理、进度追踪、多图片附件、粘贴图片、桌面背景模式、窗口置顶、迷你模式、系统托盘",
  "main": "main.js",
  "scripts": {
    "start": "npm run vue:build && electron .",
    "dev": "electron . --dev",
    "vue:dev": "cd src && npm run dev",
    "vue:build": "cd src && npm run build",
    "build": "npm run vue:build && electron-builder",
    "build:win": "npm run vue:build && electron-builder --win",
    "build:mac": "npm run vue:build && electron-builder --mac",
    "build:linux": "npm run vue:build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "todo",
    "task",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.todox.app",
    "productName": "TodoX",
    "icon": "assets/X.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "dist-vue/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/X.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/X.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "timestamp": false
    },
    "linux": {
      "icon": "assets/X.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
